generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String            @id @default(cuid())
  fullName                  String
  email                     String            @unique
  password                  String
  role                      String            @default("parent")
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  phone                     String?           @unique
  institution               String?
  institutionType           String?
  state                     String?
  city                      String?
  hearAbout                 String?
  staffRole                 String?
  staffDepartment           String?
  staffClassAssigned        String?
  staffSubjectsAssigned     String[]          @default([])
  schoolId                  Int?
  selectedSchoolId          Int?
  staffPosition             String?
  profileImage              String?
  accountStatus             String            @default("active")
  sessionVersion            Int               @default(1)
  linkedStudentId           String?
  parentAccessCode          String?           @unique
  parentAccessCodeUsed      Boolean           @default(false)
  staffRegistrationCode     String?           @unique
  staffRegistrationCodeUsed Boolean           @default(false)
  firstName                 String
  lastName                  String
  middleName                String?
  roleId                    String?
  username                  String            @unique
  activities                ActivityLog[]
  adminProfile              Admin?
  teacherAttendances        Attendance[]      @relation("TeacherAttendance")
  auditLogs                 AuditLog[]
  guardianProfile           Guardian?
  receivedMessages          Message[]         @relation("ReceivedMessages")
  sentMessages              Message[]         @relation("SentMessages")
  notifications             Notification[]
  pushSubscriptions         PushSubscription[]
  parentProfile             Parent?
  principalProfile          Principal?
  refreshTokens             RefreshToken[]
  sessions                  Session[]
  staffProfile              Staff?
  staffInvitations          StaffInvitation[]
  studentProfile            Student?
  teacherProfile            Teacher?
  transactions              Transaction[]
  roleRef                   Role?             @relation(fields: [roleId], references: [id])
  selectedSchool            School?           @relation("UserSelectedSchool", fields: [selectedSchoolId], references: [id])
  vicePrincipalProfile      VicePrincipal?
  wallet                    Wallet?
  expensesCreated           Expense[]

  @@index([email])
  @@index([username])
  @@index([role])
}

model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  deviceName String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Role {
  id              String           @id @default(cuid())
  schoolId        Int?
  name            String
  displayName     String?
  isSystem        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
  users           User[]
  Permission      Permission[]     @relation("RolePermission")

  @@unique([schoolId, name])
  @@index([schoolId, name])
}

model Permission {
  id              String           @id @default(cuid())
  schoolId        Int?
  name            String
  code            String            @unique
  description     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  rolePermissions RolePermission[]
  Role            Role[]            @relation("RolePermission")

  @@index([schoolId, code])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model StaffInvitation {
  id               String    @id @default(cuid())
  staffName        String
  email            String    @unique
  role             String?
  department       String?
  assignedClass    String?
  assignedSubjects String[]  @default([])
  employmentStatus String?   @default("active")
  registrationCode String    @unique
  generatedAt      DateTime  @default(now())
  generatedBy      String?
  status           String    @default("unused")
  usedAt           DateTime?
  revokedAt        DateTime?
  staffUserId      String?
  schoolId         Int?
  updatedAt        DateTime  @default(now()) @updatedAt
  school           School?   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user             User?     @relation(fields: [staffUserId], references: [id])

  @@unique([schoolId, email])
  @@index([schoolId, generatedAt])
}

model Wallet {
  id                      String        @id @default(cuid())
  userId                  String        @unique
  accountNumber           String        @unique
  accountName             String
  bankName                String
  bankCode                String
  currency                String        @default("NGN")
  balance                 Decimal       @default(0.00) @db.Decimal(12, 2)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  autoPaymentEnabled      Boolean       @default(false)
  dailyTransactionLimit   Decimal?      @db.Decimal(12, 2)
  defaultPaymentMethod    String?
  frozenBalance           Decimal       @default(0.00) @db.Decimal(12, 2)
  monthlyTransactionLimit Decimal?      @db.Decimal(12, 2)
  nickname                String?
  notes                   String?
  notificationPreferences Json?
  parentUserId            String?
  spendingLimit           Decimal?      @db.Decimal(12, 2)
  status                  String        @default("active")
  studentUserId           String?
  transactions            Transaction[]
  user                    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id          String   @id @default(cuid())
  walletId    String
  userId      String
  idempotencyKey String? @unique
  reference   String   @unique
  type        String
  amount      Decimal  @db.Decimal(12, 2)
  status      String
  description String?
  source      String?
  destination String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model School {
  id                      Int                      @id @default(autoincrement())
  name                    String
  address                 String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  city                    String?
  country                 String?
  email                   String?
  isActive                Boolean                  @default(true)
  logo                    String?
  phone                   String?
  state                   String?
  timezone                String?                  @default("UTC")
  website                 String?
  academicYears           AcademicYear[]
  activityLogs            ActivityLog[]
  admins                  Admin[]
  admissions              Admission[]
  announcements           Announcement[]
  assessments             Assessment[]
  classMarkerIntegrations ClassMarkerIntegration[]
  assignments             Assignment[]
  auditLogs               AuditLog[]
  books                   Book[]
  bookCategories          BookCategory[]
  borrowRecords           BorrowRecord[]
  campuses                Campus[]
  classes                 Class[]
  classrooms              Classroom[]
  departments             Department[]
  discounts               Discount[]
  drivers                 Driver[]
  emailLogs               EmailLog[]
  enrollments             Enrollment[]
  exams                   Exam[]
  feeCategories           FeeCategory[]
  expenseCategories       ExpenseCategory[]
  expenses                Expense[]
  feeStructures           FeeStructure[]
  fines                   Fine[]
  grades                  Grade[]
  gradeScales             GradeScale[]
  guardians               Guardian[]
  hostels                 Hostel[]
  installmentPlans        InstallmentPlan[]
  invoices                Invoice[]
  messages                Message[]
  notifications           Notification[]
  parents                 Parent[]
  payments                Payment[]
  paymentIdempotencies    PaymentIdempotency[]
  principals              Principal[]
  receipts                Receipt[]
  staffInvitations        StaffInvitation[]
  reportCards             ReportCard[]
  results                 Result[]
  rooms                   Room[]
  roomAllocations         RoomAllocation[]
  routes                  Route[]
  scholarships            Scholarship[]
  sections                Section[]
  settings                Settings[]
  staff                   Staff[]
  students                Student[]
  studentAttendances      StudentAttendance[]
  studentProfiles         StudentProfile[]
  selectedByUsers         User[]                   @relation("UserSelectedSchool")
  studentTransports       StudentTransport[]
  subjects                Subject[]
  teacherAttendances      TeacherAttendance[]
  teachers                Teacher[]
  terms                   Term[]
  timetables              Timetable[]
  timetableEntries        TimetableEntry[]
  vehicles                Vehicle[]
  vicePrincipals           VicePrincipal[]
}

model Campus {
  id        String   @id @default(cuid())
  schoolId  Int
  name      String
  address   String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, name])
  @@index([schoolId, name])
}

model AcademicYear {
  id                 String              @id @default(cuid())
  schoolId           Int
  name               String
  startsAt            DateTime
  endsAt              DateTime
  isActive            Boolean             @default(false)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  admissions         Admission[]
  classes            Class[]
  students           Enrollment[]
  terms              Term[]
  grades             Grade[]
  attendances        Attendance[]
  studentAttendances StudentAttendance[]
  studentFees        StudentFee[]
  invoices           Invoice[]
  payments           Payment[]

  @@unique([schoolId, name])
  @@index([schoolId, isActive])
}

model Term {
  id                 String              @id @default(cuid())
  schoolId           Int
  academicYearId     String
  name               String
  startsAt           DateTime
  endsAt             DateTime
  isActive            Boolean             @default(false)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  admissions         Admission[]
  enrollments        Enrollment[]
  expenses           Expense[]
  grades             Grade[]
  attendances        Attendance[]
  studentAttendances StudentAttendance[]
  studentFees        StudentFee[]
  invoices           Invoice[]
  payments           Payment[]
  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, name])
  @@index([schoolId, isActive])
}

model Department {
  id          String    @id @default(cuid())
  schoolId    Int
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staff       Staff[]
  subjects    Subject[]
  teachers    Teacher[]

  @@unique([schoolId, name])
  @@index([schoolId, name])
}

model Class {
  id             String              @id @default(cuid())
  schoolId       Int
  academicYearId String?
  name           String
  level          String?
  capacity       Int                 @default(0)
  teacherName    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  academicYear   AcademicYear?       @relation(fields: [academicYearId], references: [id])
  school         School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollments    Enrollment[]
  sections       Section[]
  subjects       SubjectClass[]
  teacherClasses TeacherClass[]

  @@unique([schoolId, name])
  @@index([schoolId, name])
}

model Section {
  id          String       @id @default(cuid())
  schoolId    Int
  classId     String
  name        String
  teacherId   String?
  capacity    Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  enrollments Enrollment[]
  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  school      School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher     Teacher?     @relation(fields: [teacherId], references: [id], onDelete: NoAction)

  @@unique([classId, name])
  @@index([schoolId, classId])
}

model Subject {
  id              String           @id @default(cuid())
  schoolId        Int
  departmentId    String?
  name            String
  code            String?
  category        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  assessments     Assessment[]
  assignments     Assignment[]
  exams           Exam[]
  grades          Grade[]
  results         Result[]
  department      Department?      @relation(fields: [departmentId], references: [id])
  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classes         SubjectClass[]
  teacherSubjects TeacherSubject[]

  @@unique([schoolId, name])
  @@index([schoolId, name])
}

model SubjectClass {
  id        String   @id @default(cuid())
  classId   String
  subjectId String
  createdAt DateTime @default(now())
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId])
}

model Classroom {
  id        String   @id @default(cuid())
  schoolId  Int
  name      String
  capacity  Int      @default(0)
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, name])
  @@index([schoolId, name])
}

model Admin {
  id          String   @id @default(cuid())
  schoolId    Int
  createdAt   DateTime @default(now())
  designation String?
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  userId      String?  @unique
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id])

  @@index([schoolId, isActive])
}

model Staff {
  id               String      @id @default(cuid())
  userId           String?     @unique
  schoolId         Int
  departmentId     String?
  designation      String?
  employmentStatus String      @default("active")
  isActive         Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  department       Department? @relation(fields: [departmentId], references: [id])
  school           School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user             User?       @relation(fields: [userId], references: [id])

  @@index([schoolId, isActive])
}

model Teacher {
  id           String              @id @default(cuid())
  schoolId     Int
  createdAt    DateTime            @default(now())
  departmentId String?
  designation  String?
  hireDate     DateTime?
  isActive     Boolean             @default(true)
  updatedAt    DateTime            @updatedAt
  userId       String?             @unique
  assessments  Assessment[]
  assignments  Assignment[]
  exams        Exam[]
  results      Result[]
  department   Department?         @relation(fields: [departmentId], references: [id])
  school       School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user         User?               @relation(fields: [userId], references: [id])
  attendances  TeacherAttendance[]
  classes      TeacherClass[]
  sections     Section[]
  subjects     TeacherSubject[]

  @@index([schoolId, isActive])
}

model TeacherSubject {
  id        String   @id @default(cuid())
  teacherId String
  subjectId String
  schoolId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId])
  @@index([schoolId, teacherId])
}

