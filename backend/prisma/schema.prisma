generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         String   @id @default(cuid())
  firstName                  String
  middleName                 String?
  lastName                   String
  username                   String   @unique
  fullName                   String
  email                      String   @unique
  password                   String
  phone                      String?  @unique
  profileImage               String?
  institution                String?
  institutionType            String?
  state                      String?
  city                       String?
  hearAbout                  String?
  role                       String   @default("parent")
  accountStatus              String   @default("active")
  schoolId                   Int?
  staffRole                  String?
  staffDepartment            String?
  staffClassAssigned         String?
  staffSubjectsAssigned      String[] @default([])
  staffPosition              String?
  staffRegistrationCode      String?  @unique
  staffRegistrationCodeUsed  Boolean  @default(false)
  parentAccessCode           String?  @unique
  parentAccessCodeUsed       Boolean  @default(false)
  linkedStudentId            String?
  roleId                     String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  roleRef                    Role?    @relation(fields: [roleId], references: [id])
  wallet                     Wallet?
  transactions               Transaction[]
  sessions                   Session[]
  refreshTokens              RefreshToken[]
  teacherAttendances         Attendance[] @relation("TeacherAttendance")
  staffInvitations           StaffInvitation[]
  activities                 ActivityLog[]
  auditLogs                  AuditLog[]
  notifications              Notification[]
  sentMessages               Message[] @relation("SentMessages")
  receivedMessages           Message[] @relation("ReceivedMessages")
  teacherProfile             Teacher?
  adminProfile               Admin?
  principalProfile           Principal?
  vicePrincipalProfile      VicePrincipal?
  staffProfile               Staff?
  parentProfile              Parent?
  guardianProfile            Guardian?
  studentProfile             Student?

  @@index([email])
  @@index([username])
  @@index([role])
}

model Role {
  id            String   @id @default(cuid())
  schoolId      Int?
  name          String
  displayName   String?
  isSystem      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users         User[]
  permissions   Permission[] @relation("RolePermission")
  rolePermissions RolePermission[]

  @@unique([schoolId, name])
  @@index([schoolId, name])
}

model Permission {
  id          String   @id @default(cuid())
  schoolId    Int?
  name        String
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles       Role[] @relation("RolePermission")
  rolePermissions RolePermission[]

  @@index([schoolId, code])
}

model RolePermission {
  id            String   @id @default(cuid())
  roleId        String
  permissionId  String
  createdAt     DateTime @default(now())

  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model RefreshToken {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Wallet {
  id            String        @id @default(cuid())
  userId        String        @unique
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountNumber String        @unique
  accountName   String
  bankName      String
  bankCode      String
  currency      String        @default("NGN")
  balance       Float         @default(0.0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  transactions  Transaction[]
}

model Transaction {
  id            String   @id @default(cuid())
  walletId      String
  userId        String
  reference     String   @unique
  type          String
  amount        Float
  status        String
  description   String?
  source        String?
  destination   String?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  wallet        Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model StaffInvitation {
  id                      String    @id @default(cuid())
  staffName               String
  email                   String    @unique
  role                    String?
  department              String?
  assignedClass           String?
  assignedSubjects        String[]  @default([])
  employmentStatus        String?   @default("active")
  registrationCode        String    @unique
  generatedBy             String?
  status                  String    @default("unused")
  revokedAt               DateTime?
  usedAt                  DateTime?
  staffUserId             String?
  generatedAt             DateTime  @default(now())
  updatedAt               DateTime  @default(now()) @updatedAt

  user                    User?     @relation(fields: [staffUserId], references: [id])
}

model School {
  id                  Int      @id @default(autoincrement())
  name                String
  address             String?
  email               String?
  phone               String?
  logo                String?
  website             String?
  country             String?
  state               String?
  city                String?
  timezone            String?  @default("UTC")
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  campuses            Campus[]
  academicYears      AcademicYear[]
  terms               Term[]
  departments         Department[]
  classes             Class[]
  sections            Section[]
  subjects            Subject[]
  classrooms          Classroom[]
  admins              Admin[]
  principals          Principal[]
  vicePrincipals      VicePrincipal[]
  staff               Staff[]
  teachers            Teacher[]
  students            Student[]
  parents             Parent[]
  guardians           Guardian[]
  studentProfiles     StudentProfile[]
  admissions          Admission[]
  studentFees         StudentFee[]
  installmentPlans    InstallmentPlan[]
  enrollments         Enrollment[]
  exams               Exam[]
  assessments         Assessment[]
  assignments         Assignment[]
  results             Result[]
  grades              Grade[]
  gradeScales         GradeScale[]
  reportCards         ReportCard[]
  feeCategories       FeeCategory[]
  feeStructures       FeeStructure[]
  invoices            Invoice[]
  payments            Payment[]
  paymentMethods      PaymentMethod[]
  receipts            Receipt[]
  scholarships        Scholarship[]
  discounts           Discount[]
  fines               Fine[]
  books               Book[]
  bookCategories      BookCategory[]
  borrowRecords       BorrowRecord[]
  vehicles            Vehicle[]
  routes              Route[]
  drivers             Driver[]
  studentTransports   StudentTransport[]
  announcements       Announcement[]
  notifications       Notification[]
  messages            Message[]
  emailLogs           EmailLog[]
  timetables          Timetable[]
  timetableEntries    TimetableEntry[]
  hostels             Hostel[]
  rooms               Room[]
  roomAllocations     RoomAllocation[]
  auditLogs           AuditLog[]
  activityLogs        ActivityLog[]
  settings            Settings[]
  studentAttendances  StudentAttendance[]
  teacherAttendances  TeacherAttendance[]

  @@unique([name, country])
  @@index([name])
}

model Campus {
  id        String   @id @default(cuid())
  schoolId  Int
  name      String
  address   String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, name])
  @@index([schoolId, name])
}

model AcademicYear {
  id        String   @id @default(cuid())
  schoolId  Int
  name      String
  startsAt  DateTime
  endsAt    DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  terms     Term[]
  classes   Class[]
  students  Enrollment[]
  admissions Admission[]

  @@unique([schoolId, name])
  @@index([schoolId, isActive])
}

model Term {
  id              String   @id @default(cuid())
  schoolId        Int
  academicYearId String
  name            String
  startsAt        DateTime
  endsAt          DateTime
  isActive        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  school          School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  enrollments     Enrollment[]
  admissions      Admission[]

  @@unique([academicYearId, name])
  @@index([schoolId, isActive])
}

model Department {
  id          String   @id @default(cuid())
  schoolId    Int
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subjects    Subject[]
  staff       Staff[]
  teachers    Teacher[]

  @@unique([schoolId, name])
  @@index([schoolId, name])
}

model Class {
  id              String   @id @default(cuid())
  schoolId        Int
  academicYearId String?
  name            String
  level           String?
  capacity        Int      @default(0)
  teacherName     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  school          School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear?  @relation(fields: [academicYearId], references: [id])
  sections        Section[]
  subjects        SubjectClass[]
  teacherClasses  TeacherClass[]
  enrollments     Enrollment[]
  attendances     StudentAttendance[]

  @@unique([schoolId, name])
  @@index([schoolId, name])
}

model Section {
  id          String   @id @default(cuid())
  schoolId    Int
  classId     String
  name        String
  capacity    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]

  @@unique([classId, name])
  @@index([schoolId, classId])
}

model Subject {
  id            String   @id @default(cuid())
  schoolId      Int
  departmentId  String?
  name          String
  code          String?
  category      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school        School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  department    Department?   @relation(fields: [departmentId], references: [id])
  classes       SubjectClass[]
  teacherSubjects TeacherSubject[]
  exams         Exam[]
  assessments   Assessment[]
  assignments   Assignment[]
  results       Result[]
  grades        Grade[]

  @@unique([schoolId, name])
  @@index([schoolId, name])
}

model SubjectClass {
  id        String   @id @default(cuid())
  classId   String
  subjectId String
  createdAt DateTime @default(now())

  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId])
}

model Classroom {
  id          String   @id @default(cuid())
  schoolId    Int
  name        String
  capacity    Int      @default(0)
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, name])
  @@index([schoolId, name])
}

model Admin {
  id              String   @id @default(cuid())
  userId          String?  @unique
  schoolId        Int
  designation     String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, isActive])
}

model Principal {
  id              String   @id @default(cuid())
  userId          String?  @unique
  schoolId        Int
  designation     String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, isActive])
}

model VicePrincipal {
  id              String   @id @default(cuid())
  userId          String?  @unique
  schoolId        Int
  designation     String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, isActive])
}

model Staff {
  id                String   @id @default(cuid())
  userId            String?  @unique
  schoolId          Int
  departmentId      String?
  designation       String?
  employmentStatus  String   @default("active")
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  school            School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  department        Department? @relation(fields: [departmentId], references: [id])

  @@index([schoolId, isActive])
}

model Teacher {
  id                String   @id @default(cuid())
  userId            String?  @unique
  schoolId          Int
  departmentId      String?
  designation       String?
  hireDate          DateTime?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  school            School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  department        Department? @relation(fields: [departmentId], references: [id])
  subjects          TeacherSubject[]
  classes           TeacherClass[]
  attendances       TeacherAttendance[]
  assessments       Assessment[]
  results           Result[]
  exams             Exam[]
  assignments       Assignment[]

  @@index([schoolId, isActive])
}

model TeacherSubject {
  id         String   @id @default(cuid())
  teacherId  String
  subjectId  String
  schoolId   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  teacher    Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId])
  @@index([schoolId, teacherId])
}

model TeacherClass {
  id         String   @id @default(cuid())
  teacherId  String
  classId    String
  schoolId   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  teacher    Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class      Class    @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([teacherId, classId])
  @@index([schoolId, teacherId])
}

model Student {
  id                    String   @id @default(cuid())
  userId                String?  @unique
  schoolId              Int
  name                  String?
  admissionNumber       String?  @unique
  status                String   @default("active")
  gender                String?
  className             String?
  dob                   DateTime?
  guardianName          String?
  parentPhone           String?
  parentEmail           String?
  parentAccessCode      String?  @unique
  parentAccessCodeUsed  Boolean  @default(false)
  parentId              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user                  User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  school                School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  profile               StudentProfile?
  medicalInfo           StudentMedicalInfo?
  documents             StudentDocument[]
  admissions            Admission[]
  enrollments           Enrollment[]
  parents               StudentParent[]
  guardians             GuardianStudent[]
  attendances           StudentAttendance[]
  teacherAttendances    Attendance[]
  results               Result[]
  studentFees           StudentFee[]
  invoices              Invoice[]
  payments              Payment[]
  installmentPlans      InstallmentPlan[]
  examResults           ExamResult[]
  assignments           Assignment[]
  reportCards           ReportCard[]

  @@index([schoolId, admissionNumber])
}

model Parent {
  id            String   @id @default(cuid())
  userId        String?  @unique
  schoolId      Int
  name          String
  phone         String?
  email         String?
  address       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentLinks  StudentParent[]

  @@index([schoolId, name])
}

model Guardian {
  id            String   @id @default(cuid())
  userId        String?  @unique
  schoolId      Int
  name          String
  phone         String?
  email         String?
  relation      String?
  address       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentLinks  GuardianStudent[]

  @@index([schoolId, name])
}

model StudentParent {
  id         String   @id @default(cuid())
  studentId  String
  parentId   String
  relation   String?
  createdAt  DateTime @default(now())

  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent     Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([studentId, parentId])
}

model GuardianStudent {
  id         String   @id @default(cuid())
  studentId  String
  guardianId String
  relation   String?
  createdAt  DateTime @default(now())

  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian   Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
}

model StudentProfile {
  id                  String   @id @default(cuid())
  studentId           String   @unique
  admissionNumber     String?
  bloodGroup          String?
  emergencyContact    String?
  emergencyName       String?
  address             String?
  nationality         String?
  religion            String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  student             Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  school              School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId            Int?
}

model StudentMedicalInfo {
  id                String   @id @default(cuid())
  studentId         String   @unique
  allergies         String?
  medicalConditions String?
  medications       String?
  doctorName        String?
  doctorPhone       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model StudentDocument {
  id            String   @id @default(cuid())
  studentId     String
  documentType  String
  fileUrl       String
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, documentType])
}

model Admission {
  id               String   @id @default(cuid())
  schoolId         Int
  studentId        String
  academicYearId  String?
  termId           String?
  status           String   @default("pending")
  admissionDate    DateTime?
  remarks          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  school           School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student          Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear    AcademicYear? @relation(fields: [academicYearId], references: [id])
  term             Term?         @relation(fields: [termId], references: [id])

  @@index([schoolId, status])
}

model Enrollment {
  id               String   @id @default(cuid())
  schoolId         Int
  studentId        String
  classId          String?
  sectionId        String?
  academicYearId  String?
  termId           String?
  status           String   @default("active")
  enrolledAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  school           School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student          Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class            Class?        @relation(fields: [classId], references: [id])
  section          Section?      @relation(fields: [sectionId], references: [id])
  academicYear    AcademicYear? @relation(fields: [academicYearId], references: [id])
  term             Term?         @relation(fields: [termId], references: [id])

  @@index([schoolId, status])
}

model Attendance {
  id          String   @id @default(cuid())
  teacherId   String
  teacher     User     @relation("TeacherAttendance", fields: [teacherId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  className   String
  date        DateTime
  status      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StudentAttendance {
  id            String   @id @default(cuid())
  schoolId      Int
  studentId     String
  classId       String?
  attendanceDate DateTime
  status        String   @default("present")
  remarks       String?
  markedById    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class         Class?   @relation(fields: [classId], references: [id])

  @@index([schoolId, attendanceDate])
  @@index([studentId, attendanceDate])
}

model TeacherAttendance {
  id            String   @id @default(cuid())
  schoolId      Int
  teacherId     String
  attendanceDate DateTime
  status        String   @default("present")
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher       Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([schoolId, attendanceDate])
}

model Assessment {
  id          String   @id @default(cuid())
  teacherId   String
  schoolId    Int
  subjectId   String?
  title       String
  subject     String
  className   String
  maxScore    Int
  date        DateTime
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subjectRef  Subject? @relation(fields: [subjectId], references: [id])
  results     Result[]

  @@index([schoolId, date])
}

model Result {
  id            String   @id @default(cuid())
  teacherId     String
  studentId     String
  assessmentId  String?
  schoolId      Int
  subjectId     String?
  subject       String
  className     String
  score         Float
  maxScore      Int
  published     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  teacher       Teacher    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  student       Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assessment    Assessment? @relation(fields: [assessmentId], references: [id])
  school        School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subjectRef    Subject?   @relation(fields: [subjectId], references: [id])

  @@index([schoolId, studentId])
}

model Exam {
  id            String   @id @default(cuid())
  schoolId      Int
  teacherId     String?
  subjectId     String?
  title         String
  examDate      DateTime
  totalMarks    Int      @default(100)
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher       Teacher?  @relation(fields: [teacherId], references: [id])
  subject       Subject?  @relation(fields: [subjectId], references: [id])
  results       ExamResult[]

  @@index([schoolId, examDate])
