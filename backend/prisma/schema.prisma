generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String            @id @default(cuid())
  fullName                  String
  email                     String            @unique
  password                  String
  role                      String            @default("parent")
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  phone                     String?           @unique
  institution               String?
  institutionType           String?
  state                     String?
  city                      String?
  hearAbout                 String?
  staffRole                 String?
  staffDepartment           String?
  staffClassAssigned        String?
  staffSubjectsAssigned     String[]          @default([])
  schoolId                  Int?
  staffPosition             String?
  profileImage              String?
  accountStatus             String            @default("active")
  linkedStudentId           String?
  parentAccessCode          String?           @unique
  parentAccessCodeUsed      Boolean           @default(false)
  staffRegistrationCode     String?           @unique
  staffRegistrationCodeUsed Boolean           @default(false)
  firstName                 String
  lastName                  String
  middleName                String?
  roleId                    String?
  username                  String            @unique
  activities                ActivityLog[]
  adminProfile              Admin?
  teacherAttendances        Attendance[]      @relation("TeacherAttendance")
  auditLogs                 AuditLog[]
  guardianProfile           Guardian?
  receivedMessages          Message[]         @relation("ReceivedMessages")
  sentMessages              Message[]         @relation("SentMessages")
  notifications             Notification[]
  parentProfile             Parent?
  principalProfile          Principal?
  refreshTokens             RefreshToken[]
  sessions                  Session[]
  staffProfile              Staff?
  staffInvitations          StaffInvitation[]
  studentProfile            Student?
  teacherProfile            Teacher?
  transactions              Transaction[]
  roleRef                   Role?             @relation(fields: [roleId], references: [id])
  vicePrincipalProfile      VicePrincipal?
  wallet                    Wallet?
  expensesCreated           Expense[]

  @@index([email])
  @@index([username])
  @@index([role])
}

model Role {
  id              String           @id @default(cuid())
  schoolId        Int?
  name            String
  displayName     String?
  isSystem        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
  users           User[]
  Permission      Permission[]     @relation("RolePermission")

  @@unique([schoolId, name])
  @@index([schoolId, name])
}

model Permission {
  id              String           @id @default(cuid())
  schoolId        Int?
  name            String
  code            String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
  Role            Role[]           @relation("RolePermission")

  @@index([schoolId, code])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model StaffInvitation {
  id               String    @id @default(cuid())
  staffName        String
  email            String    @unique
  role             String?
  department       String?
  assignedClass    String?
  assignedSubjects String[]  @default([])
  employmentStatus String?   @default("active")
  registrationCode String    @unique
  generatedAt      DateTime  @default(now())
  generatedBy      String?
  status           String    @default("unused")
  usedAt           DateTime?
  revokedAt        DateTime?
  staffUserId      String?
  schoolId         Int?
  updatedAt        DateTime  @default(now()) @updatedAt
  school           School?   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user             User?     @relation(fields: [staffUserId], references: [id])

  @@unique([schoolId, email])
  @@index([schoolId, generatedAt])
}

model Wallet {
  id                      String        @id @default(cuid())
  userId                  String        @unique
  accountNumber           String        @unique
  accountName             String
  bankName                String
  bankCode                String
  currency                String        @default("NGN")
  balance                 Float         @default(0.0)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  autoPaymentEnabled      Boolean       @default(false)
  dailyTransactionLimit   Float?
  defaultPaymentMethod    String?
  frozenBalance           Float         @default(0.0)
  monthlyTransactionLimit Float?
  nickname                String?
  notes                   String?
  notificationPreferences Json?
  parentUserId            String?
  spendingLimit           Float?
  status                  String        @default("active")
  studentUserId           String?
  transactions            Transaction[]
  user                    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id          String   @id @default(cuid())
  walletId    String
  userId      String
  reference   String   @unique
  type        String
  amount      Float
  status      String
  description String?
  source      String?
  destination String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model School {
  id                      Int                      @id @default(autoincrement())
  name                    String
  address                 String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  city                    String?
  country                 String?
  email                   String?
  isActive                Boolean                  @default(true)
  logo                    String?
  phone                   String?
  state                   String?
  timezone                String?                  @default("UTC")
  website                 String?
  academicYears           AcademicYear[]
  activityLogs            ActivityLog[]
  admins                  Admin[]
  admissions              Admission[]
  announcements           Announcement[]
  assessments             Assessment[]
  classMarkerIntegrations ClassMarkerIntegration[]
  assignments             Assignment[]
  auditLogs               AuditLog[]
  books                   Book[]
  bookCategories          BookCategory[]
  borrowRecords           BorrowRecord[]
  campuses                Campus[]
  classes                 Class[]
  classrooms              Classroom[]
  departments             Department[]
  discounts               Discount[]
  drivers                 Driver[]
  emailLogs               EmailLog[]
  enrollments             Enrollment[]
  exams                   Exam[]
  feeCategories           FeeCategory[]
  expenseCategories       ExpenseCategory[]
  expenses                Expense[]
  feeStructures           FeeStructure[]
  fines                   Fine[]
  grades                  Grade[]
  gradeScales             GradeScale[]
  guardians               Guardian[]
  hostels                 Hostel[]
  installmentPlans        InstallmentPlan[]
  invoices                Invoice[]
  messages                Message[]
  notifications           Notification[]
  parents                 Parent[]
  payments                Payment[]
  paymentMethods          PaymentMethod[]
  principals              Principal[]
  receipts                Receipt[]
  staffInvitations        StaffInvitation[]
  reportCards             ReportCard[]
  results                 Result[]
  rooms                   Room[]
  roomAllocations         RoomAllocation[]
  routes                  Route[]
  scholarships            Scholarship[]
  sections                Section[]
  settings                Settings[]
  staff                   Staff[]
  students                Student[]
  studentAttendances      StudentAttendance[]
  studentFees             StudentFee[]
  studentProfiles         StudentProfile[]
  studentTransports       StudentTransport[]
  subjects                Subject[]
  teachers                Teacher[]
  teacherAttendances      TeacherAttendance[]
  terms                   Term[]
  timetables              Timetable[]
  timetableEntries        TimetableEntry[]
  vehicles                Vehicle[]
  vicePrincipals          VicePrincipal[]

  @@unique([name, country])
  @@index([name])
}

model Campus {
  id        String   @id @default(cuid())
  schoolId  Int
  name      String
  address   String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, name])
  @@index([schoolId, name])
}

model AcademicYear {
  id         String       @id @default(cuid())
  schoolId   Int
  name       String
  startsAt   DateTime
  endsAt     DateTime
  isActive   Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  school     School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  admissions Admission[]
  classes    Class[]
  students   Enrollment[]
  terms      Term[]
  expenses   Expense[]

  @@unique([schoolId, name])
  @@index([schoolId, isActive])
}

model Term {
  id             String       @id @default(cuid())
  schoolId       Int
  academicYearId String
  name           String
  startsAt       DateTime
  endsAt         DateTime
  isActive       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  admissions     Admission[]
  enrollments    Enrollment[]
  expenses       Expense[]
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, name])
  @@index([schoolId, isActive])
}

model Department {
  id          String    @id @default(cuid())
  schoolId    Int
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staff       Staff[]
  subjects    Subject[]
  teachers    Teacher[]

  @@unique([schoolId, name])
  @@index([schoolId, name])
}

model Class {
  id             String              @id @default(cuid())
  schoolId       Int
  academicYearId String?
  name           String
  level          String?
  capacity       Int                 @default(0)
  teacherName    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  academicYear   AcademicYear?       @relation(fields: [academicYearId], references: [id])
  school         School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollments    Enrollment[]
  sections       Section[]
  attendances    StudentAttendance[]
  subjects       SubjectClass[]
  teacherClasses TeacherClass[]

  @@unique([schoolId, name])
  @@index([schoolId, name])
}

model Section {
  id          String       @id @default(cuid())
  schoolId    Int
  classId     String
  name        String
  teacherId   String?
  capacity    Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  enrollments Enrollment[]
  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher     Teacher?     @relation(fields: [teacherId], references: [id], onDelete: NoAction)

  @@unique([classId, name])
  @@index([schoolId, classId])
}

model Subject {
  id              String           @id @default(cuid())
  schoolId        Int
  departmentId    String?
  name            String
  code            String?
  category        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  assessments     Assessment[]
  assignments     Assignment[]
  exams           Exam[]
  grades          Grade[]
  results         Result[]
  department      Department?      @relation(fields: [departmentId], references: [id])
  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classes         SubjectClass[]
  teacherSubjects TeacherSubject[]

  @@unique([schoolId, name])
  @@index([schoolId, name])
}

model SubjectClass {
  id        String   @id @default(cuid())
  classId   String
  subjectId String
  createdAt DateTime @default(now())
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId])
}

model Classroom {
  id        String   @id @default(cuid())
  schoolId  Int
  name      String
  capacity  Int      @default(0)
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, name])
  @@index([schoolId, name])
}

model Admin {
  id          String   @id @default(cuid())
  schoolId    Int
  createdAt   DateTime @default(now())
  designation String?
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  userId      String?  @unique
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id])

  @@index([schoolId, isActive])
}

model Principal {
  id          String   @id @default(cuid())
  userId      String?  @unique
  schoolId    Int
  designation String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id])

  @@index([schoolId, isActive])
}

model VicePrincipal {
  id          String   @id @default(cuid())
  userId      String?  @unique
  schoolId    Int
  designation String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id])

  @@index([schoolId, isActive])
}

model Staff {
  id               String      @id @default(cuid())
  userId           String?     @unique
  schoolId         Int
  departmentId     String?
  designation      String?
  employmentStatus String      @default("active")
  isActive         Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  department       Department? @relation(fields: [departmentId], references: [id])
  school           School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user             User?       @relation(fields: [userId], references: [id])

  @@index([schoolId, isActive])
}

model Teacher {
  id           String              @id @default(cuid())
  schoolId     Int
  createdAt    DateTime            @default(now())
  departmentId String?
  designation  String?
  hireDate     DateTime?
  isActive     Boolean             @default(true)
  updatedAt    DateTime            @updatedAt
  userId       String?             @unique
  assessments  Assessment[]
  assignments  Assignment[]
  exams        Exam[]
  results      Result[]
  department   Department?         @relation(fields: [departmentId], references: [id])
  school       School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user         User?               @relation(fields: [userId], references: [id])
  attendances  TeacherAttendance[]
  classes      TeacherClass[]
  sections     Section[]
  subjects     TeacherSubject[]

  @@index([schoolId, isActive])
}

model TeacherSubject {
  id        String   @id @default(cuid())
  teacherId String
  subjectId String
  schoolId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId])
  @@index([schoolId, teacherId])
}

model TeacherClass {
  id        String   @id @default(cuid())
  teacherId String
  classId   String
  schoolId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: NoAction)

  @@unique([teacherId, classId])
  @@index([schoolId, teacherId])
}

model Student {
  id                   String              @id @default(cuid())
  schoolId             Int
  admissionNumber      String?             @unique
  className            String?
  dob                  DateTime?
  gender               String?
  guardianName         String?
  parentAccessCode     String?             @unique
  parentAccessCodeUsed Boolean             @default(false)
  parentEmail          String?
  parentId             String?
  parentPhone          String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  userId               String?             @unique
  name                 String?
  status               String              @default("active")
  admissions           Admission[]
  assignments          Assignment[]
  teacherAttendances   Attendance[]
  enrollments          Enrollment[]
  examResults          ExamResult[]
  examAttempts         ExamAttempt[]
  guardians            GuardianStudent[]
  installmentPlans     InstallmentPlan[]
  invoices             Invoice[]
  payments             Payment[]
  reportCards          ReportCard[]
  results              Result[]
  school               School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user                 User?               @relation(fields: [userId], references: [id])
  attendances          StudentAttendance[]
  documents            StudentDocument[]
  studentFees          StudentFee[]
  medicalInfo          StudentMedicalInfo?
  parents              StudentParent[]
  profile              StudentProfile?

  @@index([schoolId, admissionNumber])
}

model Parent {
  id           String          @id @default(cuid())
  name         String
  schoolId     Int
  address      String?
  createdAt    DateTime        @default(now())
  email        String?
  phone        String?
  updatedAt    DateTime        @updatedAt
  userId       String?         @unique
  school       School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user         User?           @relation(fields: [userId], references: [id])
  studentLinks StudentParent[]

  @@index([schoolId, name])
}

model Guardian {
  id           String            @id @default(cuid())
  userId       String?           @unique
  schoolId     Int
  name         String
  phone        String?
  email        String?
  relation     String?
  address      String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  school       School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user         User?             @relation(fields: [userId], references: [id])
  studentLinks GuardianStudent[]

  @@index([schoolId, name])
}

model StudentParent {
  id        String   @id @default(cuid())
  studentId String
  parentId  String
  relation  String?
  createdAt DateTime @default(now())
  parent    Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, parentId])
}

model GuardianStudent {
  id         String   @id @default(cuid())
  studentId  String
  guardianId String
  relation   String?
  createdAt  DateTime @default(now())
  guardian   Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
}

model StudentProfile {
  id               String   @id @default(cuid())
  studentId        String   @unique
  admissionNumber  String?
  bloodGroup       String?
  emergencyContact String?
  emergencyName    String?
  address          String?
  nationality      String?
  religion         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  schoolId         Int?
  school           School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model StudentMedicalInfo {
  id                String   @id @default(cuid())
  studentId         String   @unique
  allergies         String?
  medicalConditions String?
  medications       String?
  doctorName        String?
  doctorPhone       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model StudentDocument {
  id           String   @id @default(cuid())
  studentId    String
  documentType String
  fileUrl      String
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, documentType])
}

model Admission {
  id                     String        @id @default(cuid())
  schoolId               Int
  studentId              String?
  applicationCode        String?       @unique
  admissionCode          String?       @unique
  applicantId            String?       @unique
  applicantName          String?
  applicantFirstName     String?
  applicantMiddleName    String?
  applicantLastName      String?
  parentEmail            String?
  parentPhone            String?
  intendedClass          String?
  applicantGender        String?
  applicantDob           DateTime?
  applicantPlaceOfBirth  String?
  applicantNationality   String?
  applicantStateOfOrigin String?
  applicantLga           String?
  applicantLin           String?
  studentType            String?
  previousSchool         String?
  religion               String?
  ailments               String?
  challenges             String?
  bloodGroup             String?
  genotype               String?
  maritalStatus          String?
  fatherName             String?
  fatherDob              DateTime?
  fatherAddress          String?
  fatherOccupation       String?
  fatherJobTitle         String?
  fatherEmail            String?
  fatherPhone1           String?
  fatherPhone2           String?
  motherName             String?
  motherDob              DateTime?
  motherAddress          String?
  motherOccupation       String?
  motherJobTitle         String?
  motherEmail            String?
  motherPhone1           String?
  motherPhone2           String?
  feePaymentMethod       String?
  referredBy             String?
  financialAwareness     Boolean?      @default(false)
  agreeTerms             Boolean?      @default(false)
  approvedAt             DateTime?
  approvedBy             String?
  rejectedAt             DateTime?
  rejectedBy             String?
  rejectionReason        String?
  examScore              Float?
  examCompletedAt        DateTime?
  examResult             String?
  examReference          String?
  paymentReference       String?
  verifiedAt             DateTime?
  submissionData         Json?
  academicYearId         String?
  termId                 String?
  status                 String        @default("pending")
  admissionDate          DateTime?
  remarks                String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  academicYear           AcademicYear? @relation(fields: [academicYearId], references: [id])
  school                 School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student                Student?      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term                   Term?         @relation(fields: [termId], references: [id])

  @@index([schoolId, status])
  @@index([schoolId, applicationCode])
}

model Enrollment {
  id             String        @id @default(cuid())
  schoolId       Int
  studentId      String
  classId        String?
  sectionId      String?
  academicYearId String?
  termId         String?
  status         String        @default("active")
  enrolledAt     DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])
  class          Class?        @relation(fields: [classId], references: [id])
  school         School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  section        Section?      @relation(fields: [sectionId], references: [id])
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term           Term?         @relation(fields: [termId], references: [id])

  @@index([schoolId, status])
}

model Attendance {
  id        String   @id @default(cuid())
  teacherId String
  studentId String
  className String
  date      DateTime
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher   User     @relation("TeacherAttendance", fields: [teacherId], references: [id], onDelete: Cascade)
}

model StudentAttendance {
  id             String   @id @default(cuid())
  schoolId       Int
  studentId      String
  classId        String?
  attendanceDate DateTime
  status         String   @default("present")
  remarks        String?
  markedById     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  class          Class?   @relation(fields: [classId], references: [id])
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId, attendanceDate])
  @@index([studentId, attendanceDate])
}

model TeacherAttendance {
  id             String   @id @default(cuid())
  schoolId       Int
  teacherId      String
  attendanceDate DateTime
  status         String   @default("present")
  remarks        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher        Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([schoolId, attendanceDate])
}

model Assessment {
  id                     String                  @id @default(cuid())
  teacherId              String
  title                  String
  subject                String
  className              String
  maxScore               Int
  date                   DateTime
  description            String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  schoolId               Int
  subjectId              String?
  quizlabQuizId          String?                 @unique
  school                 School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subjectRef             Subject?                @relation(fields: [subjectId], references: [id])
  teacher                Teacher                 @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  results                Result[]
  exam                   Exam?
  classMarkerIntegration ClassMarkerIntegration?

  @@index([schoolId, date])
}

model Result {
  id           String      @id @default(cuid())
  teacherId    String
  studentId    String
  assessmentId String?
  subject      String
  className    String
  score        Float
  maxScore     Int
  published    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  schoolId     Int
  subjectId    String?
  assessment   Assessment? @relation(fields: [assessmentId], references: [id])
  school       School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectRef   Subject?    @relation(fields: [subjectId], references: [id])
  teacher      Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([schoolId, studentId])
}

model Exam {
  id           String        @id @default(cuid())
  schoolId     Int
  teacherId    String?
  subjectId    String?
  assessmentId String?       @unique
  title        String
  examDate     DateTime
  totalMarks   Int           @default(100)
  description  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject      Subject?      @relation(fields: [subjectId], references: [id])
  teacher      Teacher?      @relation(fields: [teacherId], references: [id])
  assessment   Assessment?   @relation(fields: [assessmentId], references: [id], onDelete: NoAction)
  results      ExamResult[]
  attempts     ExamAttempt[]

  @@index([schoolId, examDate])
  @@index([schoolId, subjectId, examDate])
}

model ExamAttempt {
  id                    String      @id @default(cuid())
  examId                String
  studentId             String
  attemptNumber         Int         @default(1)
  status                String      @default("in_progress")
  startedAt             DateTime    @default(now())
  completedAt           DateTime?
  completionTimeSeconds Int?
  score                 Float?
  percentage            Float?
  externalResultId      String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  exam                  Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  student               Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  result                ExamResult?

  @@unique([examId, studentId, attemptNumber])
  @@index([studentId, examId])
  @@index([examId, status])
}

model ExamResult {
  id          String       @id @default(cuid())
  examId      String
  studentId   String
  attemptId   String?      @unique
  marks       Float
  grade       String?
  remarks     String?
  percentage  Float?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  exam        Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  student     Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attempt     ExamAttempt? @relation(fields: [attemptId], references: [id], onDelete: NoAction)

  @@index([examId, studentId])
}

model ClassMarkerIntegration {
  id              String     @id @default(cuid())
  schoolId        Int
  assessmentId    String     @unique
  remoteExamId    String?    @unique
  remoteExamUrl   String?
  syncStatus      String     @default("pending")
  lastSyncedAt    DateTime?
  lastWebhookAt   DateTime?
  webhookEventRef String?
  lastError       String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  school          School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assessment      Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([schoolId, syncStatus])
  @@index([schoolId, lastSyncedAt])
}

model AssessmentItem {
  id        String   @id @default(cuid())
  title     String
  maxScore  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Assignment {
  id           String                 @id @default(cuid())
  schoolId     Int
  teacherId    String?
  subjectId    String?
  studentId    String?
  title        String
  description  String?
  dueDate      DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  school       School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student?               @relation(fields: [studentId], references: [id])
  subject      Subject?               @relation(fields: [subjectId], references: [id])
  teacher      Teacher?               @relation(fields: [teacherId], references: [id])
  studentLinks AssignmentSubmission[]

  @@index([schoolId, dueDate])
}

model AssignmentSubmission {
  id           String     @id @default(cuid())
  assignmentId String
  studentId    String
  fileUrl      String?
  submittedAt  DateTime   @default(now())
  status       String     @default("submitted")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
}

model GradeScale {
  id          String   @id @default(cuid())
  schoolId    Int
  name        String
  minimumMark Int
  maximumMark Int
  grade       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  grades      Grade[]
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, name])
}

model Grade {
  id           String      @id @default(cuid())
  schoolId     Int
  studentId    String?
  subjectId    String?
  gradeScaleId String?
  value        String
  remarks      String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  gradeScale   GradeScale? @relation(fields: [gradeScaleId], references: [id])
  school       School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject      Subject?    @relation(fields: [subjectId], references: [id])

  @@index([schoolId, value])
}

model ReportCard {
  id             String   @id @default(cuid())
  schoolId       Int
  studentId      String
  academicYearId String?
  termId         String?
  fileUrl        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId, studentId])
}

model FeeCategory {
  id            String         @id @default(cuid())
  schoolId      Int
  name          String
  description   String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  feeStructures FeeStructure[]

  @@unique([schoolId, name])
  @@index([schoolId, name])
}

model FeeStructure {
  id            String       @id @default(cuid())
  schoolId      Int
  feeCategoryId String?
  className     String?
  session       String?
  term          String?
  amount        Float
  dueDate       DateTime?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  feeCategory   FeeCategory? @relation(fields: [feeCategoryId], references: [id])
  school        School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentFees   StudentFee[]

  @@index([schoolId, className])
}

model StudentFee {
  id                 String        @id @default(cuid())
  schoolId           Int
  studentId          String
  feeStructureId     String?
  amount             Float
  outstandingBalance Float         @default(0)
  status             String        @default("Unpaid")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  feeStructure       FeeStructure? @relation(fields: [feeStructureId], references: [id])
  school             School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student            Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId, studentId])
}

model Invoice {
  id                 String        @id @default(cuid())
  schoolId           Int
  studentId          String
  invoiceNumber      String        @unique
  status             String        @default("Unpaid")
  dueDate            DateTime?
  totalAmount        Float
  outstandingBalance Float         @default(0)
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  school             School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student            Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  items              InvoiceItem[]
  payments           Payment[]
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int      @default(1)
  unitPrice   Float
  amount      Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model PaymentMethod {
  id        String    @id @default(cuid())
  schoolId  Int
  name      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  payments  Payment[]
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, name])
}

model Payment {
  id              String         @id @default(cuid())
  schoolId        Int
  studentId       String
  invoiceId       String?
  method          String
  status          String
  amount          Float
  paidAt          DateTime
  reference       String         @unique
  note            String?
  createdById     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  paymentMethodId String?
  invoice         Invoice?       @relation(fields: [invoiceId], references: [id])
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  school          School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student         Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  receipt         Receipt?

  @@index([schoolId, status])
  @@index([schoolId, paidAt])
}

model Receipt {
  id            String   @id @default(cuid())
  schoolId      Int
  paymentId     String   @unique
  receiptNumber String   @unique
  issuedAt      DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  payment       Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model Scholarship {
  id          String   @id @default(cuid())
  schoolId    Int
  name        String
  description String?
  amount      Float    @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, name])
}

model Discount {
  id         String   @id @default(cuid())
  schoolId   Int
  name       String
  percentage Float    @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, name])
}

model Fine {
  id        String   @id @default(cuid())
  schoolId  Int
  name      String
  amount    Float    @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, name])
}

model InstallmentPlan {
  id           String               @id @default(cuid())
  schoolId     Int
  studentId    String
  session      String?
  term         String?
  totalAmount  Float
  installments Int                  @default(1)
  status       String               @default("Active")
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  payments     InstallmentPayment[]
  school       School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model InstallmentPayment {
  id        String          @id @default(cuid())
  planId    String
  amount    Float
  dueDate   DateTime
  paidAt    DateTime?
  status    String          @default("Pending")
  reference String?         @unique
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  plan      InstallmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model BookCategory {
  id          String   @id @default(cuid())
  schoolId    Int
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  books       Book[]
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, name])
}

model Book {
  id              String         @id @default(cuid())
  schoolId        Int
  bookCategoryId  String?
  title           String
  author          String?
  isbn            String?
  quantity        Int            @default(1)
  availableCopies Int            @default(1)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  category        BookCategory?  @relation(fields: [bookCategoryId], references: [id])
  school          School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  borrowRecords   BorrowRecord[]

  @@index([schoolId, title])
}

model BorrowRecord {
  id         String    @id @default(cuid())
  schoolId   Int
  bookId     String
  studentId  String?
  borrowedAt DateTime  @default(now())
  dueDate    DateTime?
  returnedAt DateTime?
  status     String    @default("borrowed")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  book       Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  school     School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([bookId, status])
}

model Vehicle {
  id          String   @id @default(cuid())
  schoolId    Int
  plateNumber String   @unique
  model       String?
  capacity    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  drivers     Driver[]
  routes      Route[]
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model Route {
  id          String             @id @default(cuid())
  schoolId    Int
  vehicleId   String?
  name        String
  description String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  school      School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  vehicle     Vehicle?           @relation(fields: [vehicleId], references: [id])
  transports  StudentTransport[]

  @@unique([schoolId, name])
}

model Driver {
  id        String   @id @default(cuid())
  schoolId  Int
  vehicleId String?
  name      String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])
}

model StudentTransport {
  id           String   @id @default(cuid())
  schoolId     Int
  routeId      String
  studentId    String?
  pickupPoint  String?
  dropoffPoint String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  route        Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, routeId])
}

model Announcement {
  id          String   @id @default(cuid())
  schoolId    Int
  title       String
  body        String
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  schoolId  Int
  userId    String?
  title     String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])
}

model Message {
  id          String   @id @default(cuid())
  schoolId    Int
  senderId    String
  recipientId String
  subject     String?
  body        String
  sentAt      DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  recipient   User     @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sender      User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([schoolId, sentAt])
}

model EmailLog {
  id            String    @id @default(cuid())
  schoolId      Int
  recipient     String
  subject       String?
  body          String?
  status        String    @default("sent")
  dedupeKey     String?   @unique
  attempts      Int       @default(0)
  lastAttemptAt DateTime?
  errorMessage  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, status, createdAt])
  @@index([schoolId, recipient])
}

model Timetable {
  id          String           @id @default(cuid())
  schoolId    Int
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  school      School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  entries     TimetableEntry[]
}

model TimetableEntry {
  id          String    @id @default(cuid())
  schoolId    Int
  className   String
  subjectName String
  dayOfWeek   String
  startTime   String
  endTime     String
  room        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  timetableId String
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  timetable   Timetable @relation(fields: [timetableId], references: [id], onDelete: Cascade)

  @@index([schoolId, dayOfWeek, startTime])
}

model Hostel {
  id        String   @id @default(cuid())
  schoolId  Int
  name      String
  address   String?
  capacity  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  rooms     Room[]
}

model Room {
  id          String           @id @default(cuid())
  schoolId    Int
  hostelId    String
  roomNumber  String
  capacity    Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  hostel      Hostel           @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  school      School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  allocations RoomAllocation[]

  @@unique([hostelId, roomNumber])
}

model RoomAllocation {
  id          String    @id @default(cuid())
  schoolId    Int
  roomId      String
  studentId   String?
  allocatedAt DateTime  @default(now())
  vacatedAt   DateTime?
  status      String    @default("allocated")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  room        Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
}

model AuditLog {
  id        String   @id @default(cuid())
  schoolId  Int?
  userId    String?
  action    String
  entity    String?
  details   String?
  createdAt DateTime @default(now())
  school    School?  @relation(fields: [schoolId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])
}

model ActivityLog {
  id        String   @id @default(cuid())
  schoolId  Int?
  userId    String?
  activity  String
  metadata  Json?
  createdAt DateTime @default(now())
  school    School?  @relation(fields: [schoolId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])
}

model Settings {
  id        String   @id @default(cuid())
  schoolId  Int
  key       String
  value     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, key])
}

model AcademicSession {
  id        String   @id @default(cuid())
  schoolId  Int
  name      String
  term      String
  startsAt  DateTime
  endsAt    DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, isActive])
}

model AcademicClass {
  id          String   @id @default(cuid())
  schoolId    Int
  name        String
  arm         String?
  level       String?
  teacherName String?
  capacity    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([schoolId, name])
}

model AcademicSubject {
  id        String   @id @default(cuid())
  schoolId  Int
  name      String
  code      String?
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, name])
}

model ExpenseCategory {
  id        String    @id @default(cuid())
  schoolId  Int
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  expenses  Expense[]

  @@unique([schoolId, name])
  @@index([schoolId, name])
}

model Expense {
  id                String           @id @default(cuid())
  schoolId          Int
  expenseCategoryId String?
  academicYearId    String?
  termId            String?
  createdById       String?
  title             String
  amount            Float
  occurredAt        DateTime
  note              String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  school            School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  expenseCategory   ExpenseCategory? @relation(fields: [expenseCategoryId], references: [id], onDelete: NoAction)
  academicYear      AcademicYear?    @relation(fields: [academicYearId], references: [id], onDelete: NoAction)
  term              Term?            @relation(fields: [termId], references: [id], onDelete: NoAction)
  createdBy         User?            @relation(fields: [createdById], references: [id], onDelete: NoAction)

  @@index([schoolId, occurredAt])
  @@index([schoolId, academicYearId, termId])
  @@index([expenseCategoryId, occurredAt])
}
