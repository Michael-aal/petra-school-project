generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  fullName  String
  email     String   @unique
  password  String
  phone     String?
  institution String?
  institutionType String?
  state     String?
  city      String?
  hearAbout String?
  role      String   @default("parent")
  accountStatus String @default("active")
  staffRegistrationCode String? @unique
  staffRegistrationCodeUsed Boolean @default(false)
  staffRole String?
  staffDepartment String?
  staffClassAssigned String?
  staffSubjectsAssigned String[] @default([])
  staffInvitation StaffInvitation? @relation("StaffInvitationUser")
  parentAccessCode String? @unique
  parentAccessCodeUsed Boolean @default(false)
  linkedStudentId String? @unique
  linkedStudent   Student? @relation("UserLinkedStudent", fields: [linkedStudentId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wallet       Wallet?
  transactions Transaction[]
}

model Wallet {
  id            String        @id @default(cuid())
  userId        String        @unique
  user          User          @relation(fields: [userId], references: [id])
  accountNumber String        @unique
  accountName   String
  bankName      String
  bankCode      String
  currency      String        @default("NGN")
  balance       Float         @default(0.0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  transactions  Transaction[]
}

model Transaction {
  id          String   @id @default(cuid())
  wallet      Wallet   @relation(fields: [walletId], references: [id])
  walletId    String
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  reference   String   @unique
  type        String
  amount      Float
  status      String
  description String?
  source      String?
  destination String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model School {
  id        Int      @id @default(autoincrement())
  name      String
  address   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  admins    Admin[]
  teachers  Teacher[]
  students  Student[]
  parents   Parent[]
}

model Admin {
  id       String @id @default(cuid())
  name     String

  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])
}

model Teacher {
  id       String @id @default(cuid())
  name     String

  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])
}

model Student {
  id       String @id @default(cuid())
  name     String

  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])
  admissionNumber String? @unique
  gender String?
  className String?
  dob DateTime?
  guardianName String?
  parentPhone String?
  parentEmail String?
  address String?
  status String @default("active")
  deletedAt DateTime?
  parentAccessCode String? @unique
  parentAccessCodeUsed Boolean @default(false)
  parentId String? @unique
  parent User? @relation("UserLinkedStudent")
}

model Parent {
  id       String @id @default(cuid())
  name     String

  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])
}

model StaffInvitation {
  id String @id @default(cuid())
  staffName String
  email String @unique
  role String
  department String
  assignedClass String?
  assignedSubjects String[] @default([])
  employmentStatus String @default("active")
  registrationCode String @unique
  generatedAt DateTime @default(now())
  generatedBy String
  status String @default("unused")
  usedAt DateTime?
  revokedAt DateTime?
  staffUserId String? @unique
  staffUser User? @relation("StaffInvitationUser", fields: [staffUserId], references: [id])
}
