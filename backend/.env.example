DATABASE_URL=postgresql://Kayode:1234@localhost:5432/kayode?connection_limit=15&pool_timeout=30
DATABASE_CONNECTION_LIMIT=15
DATABASE_POOL_TIMEOUT=30
DATABASE_APP_ROLE=petra_app
NODE_ENV=development
PORT=5000
JWT_PRIVATE_KEY=base64-encoded-RSA-4096-private-key
JWT_PUBLIC_KEY=base64-encoded-RSA-4096-public-key
