CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173
REDIS_URL=redis://127.0.0.1:6379
REDIS_MODE=single
# For cluster/sentinel deployments, provide comma-separated redis URLs.
REDIS_NODES=redis://127.0.0.1:6379
REDIS_SENTINEL_NAME=mymaster
# Web Push: generate with `npx web-push generate-vapid-keys` and never commit the private key.
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PAYSTACK_SECRET_KEY=replace-with-paystack-secret
PAYSTACK_TIMEOUT_MS=10000
QUIZLAB_WEBHOOK_SECRET=replace-with-a-random-32-character-minimum-secret
QUIZLAB_TIMEOUT_MS=10000
PAYSTACK_CALLBACK_URL=http://localhost:5173/payment/callback
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
VITE_API_URL=http://localhost:5000
